[Unit]
Description=NetworkGames unique first-boot identity
Before=networkgames-controller.service
ConditionPathExists=!/etc/networkgames/identity-generated

[Service]
Type=oneshot
ExecStart=/usr/libexec/networkgames-firstboot
RemainAfterExit=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/etc /var/lib/systemd
ProtectHome=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
