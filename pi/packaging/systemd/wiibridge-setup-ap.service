[Unit]
Description=WiiBridge secure setup and recovery network
After=NetworkManager.service wiibridge-firstboot.service
Wants=NetworkManager.service
Before=wiibridge-controller.service

[Service]
Type=oneshot
ExecStart=/usr/libexec/wiibridge-setup-ap
RemainAfterExit=yes
Restart=on-failure
RestartSec=10s
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
