WIIBRIDGE_IMAGE=ghcr.io/OWNER/wiibridge-host:0.1.0-rc.1@sha256:14dfeb29b5ac206c479be45a32bb1752ab56951c099053e757ad8f2915b50461
WIIBRIDGE_UID=568
WIIBRIDGE_GID=568
WIIBRIDGE_LIBRARY_PATH=/mnt/POOL/WII_DATASET
WIIBRIDGE_CONFIG_PATH=/mnt/POOL/apps/wiibridge/config
WIIBRIDGE_DATA_PATH=/mnt/POOL/apps/wiibridge/data
WIIBRIDGE_CERTS_PATH=/mnt/POOL/apps/wiibridge/certs
WIIBRIDGE_LOGS_PATH=/mnt/POOL/apps/wiibridge/logs
WIIBRIDGE_BACKUPS_PATH=/mnt/POOL/apps/wiibridge/backups
WIIBRIDGE_HTTPS_BIND=192.0.2.10
WIIBRIDGE_HTTPS_PORT=8445
WIIBRIDGE_NBD_BIND=192.0.2.10
WIIBRIDGE_NBD_PORT=10809
WIIBRIDGE_EXPORT=all
WIIBRIDGE_ADMIN_TOKEN=REPLACE_WITH_AT_LEAST_20_RANDOM_CHARACTERS
# Browser bootstrap login is admin / wiibridge. The first login is forced to
# replace this password, after which /data/auth/password.json takes precedence.
WIIBRIDGE_UI_USERNAME=admin
WIIBRIDGE_UI_BOOTSTRAP_PASSWORD=wiibridge
WIIBRIDGE_SESSION_TTL=12h
WIIBRIDGE_GAMECUBE_MEMORY_CARD_MODE=physical
# The no-copy backend currently rejects emulated mode until a bounded
# save-only overlay is available.
WIIBRIDGE_GAMECUBE_HEADROOM_PERCENT=5
WIIBRIDGE_GAMECUBE_SAVE_RESERVE_MIB=1024
# Empty means use the safe MBR/FAT32 implementation limit.
WIIBRIDGE_GAMECUBE_MAX_VOLUME_GIB=
WIIBRIDGE_GAMECUBE_GENERATION_RETENTION=2
# Leave all three empty for manual switching. For automatic switching, copy
# this Pi's exact device.crt and set the token and certificate. The URL is an
# optional initial address; the Pi IP can instead be saved in the dashboard.
WIIBRIDGE_PI_URL=
WIIBRIDGE_PI_ADMIN_TOKEN=
WIIBRIDGE_PI_CERT=
# The Go heap target leaves headroom inside the container's hard memory limit.
# Increase both only after measuring a genuinely larger workload.
WIIBRIDGE_GO_MEMORY_LIMIT=384MiB
WIIBRIDGE_MEMORY_LIMIT=512m
WIIBRIDGE_CPU_LIMIT=2.0
