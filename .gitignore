*.pfx
.env
.env.*
networkgames-seed.toml

# Go and Rust outputs
bin/
target/
coverage.out
*.test

# Python
__pycache__/
*.py[cod]
.venv/

# Editors and operating systems
.vscode/
.idea/
.DS_Store
Thumbs.db
